@@ -6 +6 @@ use sbi_rs::api::debug_console::console_puts;
-use sbi_rs::{ecall_send, SbiMessage};
+use sbi_rs::{ecall_send, DebugConsoleFunction, SbiMessage};
@@ -67,0 +68,24 @@ impl ConsoleDriver for SbiConsoleV01 {
+
+/// Early console using the modern SBI debug-console byte operation.
+pub struct SbiConsoleByte;
+
+static SBI_CONSOLE_BYTE: SbiConsoleByte = SbiConsoleByte;
+
+impl SbiConsoleByte {
+    /// Selects a console that does not require a physical-memory buffer.
+    pub fn set_as_console() {
+        Console::set_driver(&SBI_CONSOLE_BYTE);
+    }
+}
+
+impl ConsoleDriver for SbiConsoleByte {
+    fn write_bytes(&self, bytes: &[u8]) {
+        for &byte in bytes {
+            let message =
+                SbiMessage::DebugConsole(DebugConsoleFunction::WriteByte { byte: byte as u64 });
+            // Safety: WriteByte contains no memory references.
+            // Ignore errors, matching the existing modern debug console.
+            let _ = unsafe { ecall_send::<()>(&message) };
+        }
+    }
+}
